---
/** Small uppercase mono label above headings. */
interface Props {
  tone?: 'muted' | 'gold' | 'green';
  class?: string;
}
const { tone = 'muted', class: className } = Astro.props;
const color = { muted: 'text-muted', gold: 'text-gold', green: 'text-link' }[tone];
---

<p class:list={['font-mono text-[10.5px] uppercase tracking-[0.14em]', color, className]}><slot /></p>
