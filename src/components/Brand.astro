---
interface Props {
  light?: boolean;
  /** Hide the name on narrow screens (the header), keeping only the mark. */
  compact?: boolean;
}
const { light = false, compact = false } = Astro.props;
---

<a href="/" class="inline-flex items-center gap-3" aria-label="The African Dream Lab, home">
  <!-- The African Dream Network mark, in the white tile the TADIS site uses. -->
  <span aria-hidden="true" class="inline-grid h-10 w-10 shrink-0 place-items-center bg-white shadow-[0_4px_12px_rgba(10,61,41,0.18)] ring-1 ring-line" style="border-radius: 12px 12px 12px 3px">
    <img src="/brand/adn-logo.png" alt="" width="30" height="31" class="h-[30px] w-auto" />
  </span>
  <span class:list={['whitespace-nowrap font-display text-[15px] font-bold', light ? 'text-white' : 'text-ink', compact && 'hidden sm:inline']}>The African Dream Lab</span>
</a>
