---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light';
  class?: string;
}
const { href, variant = 'primary', class: className } = Astro.props;
const styles = {
  primary: 'bg-primary text-white hover:bg-primary-hover',
  secondary: 'bg-card text-ink ring-1 ring-line-strong hover:ring-line-heavy',
  light: 'bg-white text-forest hover:bg-success-tint',
}[variant];
---

<a
  href={href}
  class:list={['inline-flex h-12 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius-field)] px-6 text-[15px] font-semibold transition-colors', styles, className]}
>
  <slot />
</a>
