---
import CallToAction from '../components/CallToAction.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';
import { PILLARS } from '../lib/site';

const BELIEFS = [
  { title: 'Learning ends in work', text: 'Every course leads to something you make: knowledge becomes a skill, the skill is applied, and the result is evidence anyone can see.' },
  { title: 'People decide', text: 'Tools can help us review and organise, but admissions, scholarships and grades are always decided by people.' },
  { title: 'Graduates give back', text: 'Alumni become mentors. Each cohort is taught and guided in part by the people who finished before them.' },
  { title: 'Open to everyone', text: 'Individuals, schools, companies and partners learn on the same platform, each in their own space.' },
];
---

<Base title="About" description="The African Dream Lab is a learning management platform born from TADIS, the African Dream Network International Summit.">
  <PageHeader
    eyebrow="About us"
    title="Born from a summit, built for every day."
    intro="The African Dream Lab is a learning management platform that grew out of TADIS, the African Dream Network International Summit. It turns the energy of the summit into courses, cohorts and a community that keeps building."
  />

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div class="grid gap-10 rounded-[var(--radius-panel)] bg-surface p-7 ring-1 ring-line sm:p-10 lg:grid-cols-2">
      <div class="space-y-4">
        <Eyebrow>Where we come from</Eyebrow>
        <h2 class="text-[28px] font-extrabold leading-tight">TADIS</h2>
        <p class="text-[15.5px] leading-relaxed text-body">
          The African Dream Network International Summit brings emerging African leaders together around one idea: dream, lead and transform.
          A summit can light the fire. Keeping it going takes structure, practice and people around you.
        </p>
      </div>
      <div class="space-y-4">
        <Eyebrow>What we do</Eyebrow>
        <h2 class="text-[28px] font-extrabold leading-tight">The African Dream Lab</h2>
        <p class="text-[15.5px] leading-relaxed text-body">
          The Lab is where that work continues. It runs its own cohort programme, and it is open to anyone who wants to learn: individuals on
          their own, schools and academies running cohorts, companies training their teams, and partners who publish or fund learning.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div class="mb-8 max-w-2xl space-y-2">
      <Eyebrow>What we believe</Eyebrow>
      <h2 class="text-[32px] font-extrabold leading-tight">How we think about learning.</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        BELIEFS.map((b) => (
          <article class="space-y-2 rounded-[var(--radius-card)] bg-card p-6 ring-1 ring-line">
            <h3 class="text-[18px] font-bold">{b.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-body">{b.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mb-20 bg-forest text-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-3">
        <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-gold">The African Dream Network</p>
        <h2 class="text-[32px] font-extrabold leading-tight text-white">Dream. Lead. Transform.</h2>
        <p class="text-[15px] leading-relaxed text-white/75">We exist to unite emerging African youth for a self-sustaining continent.</p>
      </div>
      <ul class="grid gap-3">
        {
          PILLARS.map((p) => (
            <li class="flex gap-4 border-t border-white/15 pt-4">
              <span class="w-16 shrink-0 font-display text-[20px] font-bold text-gold">{p.title}</span>
              <span class="text-[14px] leading-relaxed text-white/75">{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallToAction />
</Base>
